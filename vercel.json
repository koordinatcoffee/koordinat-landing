{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/app-download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPad|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/tr/app/id6788413238",
      "permanent": false
    },
    {
      "source": "/app-download",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.koordinat.coffeeapp",
      "permanent": false
    },
    {
      "source": "/app-download/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPad|iPod).*"
        }
      ],
      "destination": "https://apps.apple.com/tr/app/id6788413238",
      "permanent": false
    },
    {
      "source": "/app-download/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*Android.*"
        }
      ],
      "destination": "https://play.google.com/store/apps/details?id=com.koordinat.coffeeapp",
      "permanent": false
    },
    {
      "source": "/hakkimizda",
      "destination": "/tr/hakkimizda/",
      "permanent": true
    },
    {
      "source": "/iletisim",
      "destination": "/tr/iletisim/",
      "permanent": true
    },
    {
      "source": "/on-bilgilendirme-formu",
      "destination": "/tr/on-bilgilendirme-formu/",
      "permanent": true
    },
    {
      "source": "/mesafeli-satis-sozlesmesi",
      "destination": "/tr/mesafeli-satis-sozlesmesi/",
      "permanent": true
    },
    {
      "source": "/iptal-iade",
      "destination": "/tr/iptal-ve-iade/",
      "permanent": true
    },
    {
      "source": "/teslimat",
      "destination": "/tr/teslimat/",
      "permanent": true
    },
    {
      "source": "/odeme-ve-guvenlik",
      "destination": "/tr/odeme-ve-guvenlik/",
      "permanent": true
    },
    {
      "source": "/gizlilik",
      "destination": "/tr/gizlilik/",
      "permanent": true
    },
    {
      "source": "/cerez-politikasi",
      "destination": "/tr/cerez-politikasi/",
      "permanent": true
    },
    {
      "source": "/kullanim-kosullari",
      "destination": "/tr/kullanim-kosullari/",
      "permanent": true
    },
    {
      "source": "/menu-ve-fiyatlar",
      "destination": "/tr/menu/",
      "permanent": true
    },
    {
      "source": "/tr",
      "destination": "/tr/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
